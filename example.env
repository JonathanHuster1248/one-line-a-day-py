DB_PATH="src/data/journal_entries.db"
# Where uploaded photos/PDFs are stored. Independent of DB_PATH. Relative paths
# resolve from the working directory (repo root locally, /app in Docker); this
# value matches the default and the docker-compose bind mount.
ATTACHMENTS_PATH="one_line_day_py/src/data/attachments"
DEBUG="true"
LOG_LEVEL="INFO"
SESSION_COOKIE_SECURE="false"
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
# Allows any localhost/127.0.0.1 origin+port for local dev (overrides the strict list above)
CORS_ALLOW_ORIGIN_REGEX="^https?://(localhost|127\.0\.0\.1)(:\d+)?$"
# Interface the API binds to (default 127.0.0.1 = this machine only)
HOST="127.0.0.1"
# Serve Swagger UI / OpenAPI schema at /schema; set false on a server
ENABLE_DOCS="true"
